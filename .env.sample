DB_LOCAL_URI=mongodb://mongo:27017
DB_NAME=PeerPrepAuthDB
AUTH_PORT=8000

# Will use cloud MongoDB Atlas database
ENV=PROD

BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE
BETTER_AUTH_URL=http://localhost:8000 # Base URL of your app
EMAIL_FROM=YOUR_EMAIL_DOMAIN_HERE
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
FRONTEND_URL=http://localhost:80
VITE_FRONTEND_URL=http://localhost:5173
VITE_BETTER_AUTH_URL=http://localhost:80/api/auth
VITE_API_BASE_URL=/api
BASE_URL=http://localhost

# Gateway Port
GATEWAY_PORT=80

# --- Service Targets for the Gateway ---
# auth-service is named 'auth-service' and its internal port is 8000
AUTH_SERVICE_JWKS=http://auth-service:8000/api/auth/jwks
AUTH_SERVICE_BASE_URL=http://auth-service:8000

GATEWAY_SERVICE_TARGET=http://ngnix-gateway:80

AUTH_SERVICE_TARGET=http://auth-service:8000

QUESTION_SERVICE_TARGET=http://question-service:3013

MATCHMAKING_SERVICE_TARGET=http://matching-service:3001


# Assuming a collab-service exists, it would follow the same pattern
# COLLAB_SERVICE_TARGET=http://collab-service:3002

# JX Env file 
REDIS_HOST=redis-dev
REDIS_PORT=6379
JWT_SECRET=YOUR_JWT_SECRET_HERE

#Yarn Env File
COLLAB_HOST=0.0.0.0
COLLAB_PORT=8081
CHAT_PORT=8082

YJS_DB_NAME=yjs-docs
YJS_COLLECTION_NAME=documents
COLLAB_URL=http://collab-service:8081